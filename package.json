{
  "name": "pailangz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --import tsx tests/integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:neon:export": "node --import tsx scripts/neon-transfer.ts export",
    "db:neon:import": "node --import tsx scripts/neon-transfer.ts import",
    "db:neon:migrate": "node --import tsx scripts/neon-migrate.ts",
    "db:test:export": "NEON_DEPLOYMENT_TIER=preview NEON_TRANSFER_DIR=.local/test-transfer node --import tsx scripts/neon-transfer.ts export",
    "db:test:import": "NEON_DEPLOYMENT_TIER=preview NEON_TRANSFER_DIR=.local/test-transfer node --import tsx scripts/neon-transfer.ts import",
    "evidence:test:check": "NEON_TRANSFER_DIR=.local/test-transfer node --import tsx scripts/check-evidence-storage.ts",
    "evidence:check": "node --import tsx scripts/check-evidence-storage.ts",
    "db:split-tournaments": "node --import tsx scripts/split-official-tournament.ts",
    "db:local": "node --import tsx scripts/local-db.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "staff:provision": "node --import tsx scripts/provision-staff.ts",
    "staff:check": "node --import tsx scripts/staff-maintenance.ts check",
    "staff:passwords": "node --import tsx scripts/staff-maintenance.ts passwords",
    "staff:cleanup": "node --import tsx scripts/staff-maintenance.ts cleanup",
    "format": "prettier --write src scripts tests prisma/*.ts *.ts *.json",
    "test:web": "node --import tsx tests/web-isolated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^7.0.2",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-text": "^4.0.2",
    "libphonenumber-js": "^1.12.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "unicode-case-folding": "^1.1.1",
    "unified": "^11.0.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "dotenv": "^17.0.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
