# Run pnpm setup:local to generate independent local secrets. Never commit .env.
APP_ENV=development
DATABASE_ENV=development
DATABASE_URL=postgresql://pailangz_app:LOCAL_RUNTIME_PASSWORD@localhost:5432/pailangz?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://postgres:LOCAL_OWNER_PASSWORD@localhost:5432/pailangz?sslmode=disable
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# JSON keyring of base64 32-byte AES keys, e.g. {"v1":"..."}
DATA_ENCRYPTION_KEYS=
ACTIVE_ENCRYPTION_KEY=v1
PHONE_DEFAULT_COUNTRY=MY
# Only a verified responder URL; never the /edit link.
GOOGLE_FORM_RESPONDER_URL=
REGISTRATION_WEBHOOK_SECRET=
PRIVATE_EXPORT_ENABLED=false
EVIDENCE_STORAGE=local
EVIDENCE_LOCAL_DIR=.local/evidence
# Required for S3-compatible private evidence in production. Block public access.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Production requires TLS and separate preview databases. Protect Vercel previews.
